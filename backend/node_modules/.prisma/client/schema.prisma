// INMOVISIÓN 360 SUITE — Prisma Schema
// Motor: SQLite (archivo local, sin servidor)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Enums (SQLite no soporta enum nativo, se usan String) ────
// Rol:         arrendador | inquilino | admin
// PlanId:      free | starter | professional | enterprise
// ListingType: rent | sale | rent_sale | vacation
// VisitaEstado:pendiente | confirmada | cancelada
// PagoEstado:  pendiente | pagado | vencido
// LeadEstado:  new | contactado | interesado | visita_agendada | lost

model Usuario {
  id        String    @id @default(cuid())
  nombre    String
  apellido  String    @default("")
  email     String    @unique
  password  String
  rol       String    @default("inquilino") // arrendador | inquilino | admin
  plan      String    @default("free") // free | starter | professional | enterprise
  telefono  String?
  verified  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  propiedades   Propiedad[]    @relation("OwnerProps")
  visitas       Visitas[]      @relation("InquilinoVisitas")
  mensajesEnv   Mensaje[]      @relation("MensajesDe")
  mensajesRec   Mensaje[]      @relation("MensajesPara")
  leads         Lead[]         @relation("OwnerLeads")
  pagosOwner    Pago[]         @relation("OwnerPagos")
  pagosInq      Pago[]         @relation("InquilinoPagos")
  favoritos     Favorito[]
  suscripcion   Suscripcion?
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Plan {
  id       String @id // free | starter | professional | enterprise
  nombre   String
  precio   Int    @default(0)
  propsMax Int? // null = ilimitado

  @@map("planes")
}

model Propiedad {
  id           String    @id @default(cuid())
  titulo       String
  ciudad       String
  barrio       String    @default("")
  tipo         String // apartamento | casa | villa | loft | estudio
  listing      String    @default("rent") // rent | sale | rent_sale | vacation
  precio       Int
  estrato      Int?
  habitaciones Int       @default(1)
  banos        Int       @default(1)
  metros       Int
  parqueaderos Int       @default(0)
  fotos        String    @default("[]") // JSON array serializado
  comodidades  String    @default("[]") // JSON array serializado
  video        String?
  tourVirtual  Boolean   @default(false)
  tourUrl      String?
  tourTipo     String?
  mapa2d       Boolean   @default(false)
  destacado    Boolean   @default(false)
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  owner     Usuario    @relation("OwnerProps", fields: [ownerId], references: [id])
  visitas   Visitas[]
  mensajes  Mensaje[]
  leads     Lead[]
  pagos     Pago[]
  favoritos Favorito[]

  @@map("propiedades")
}

model Visitas {
  id          String   @id @default(cuid())
  cliente     String
  inquilinoId String?
  propId      String
  fecha       String
  hora        String
  estado      String   @default("pendiente") // pendiente | confirmada | cancelada
  nota        String?
  createdAt   DateTime @default(now())

  inquilino Propiedad @relation(fields: [propId], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation("InquilinoVisitas", fields: [inquilinoId], references: [id])

  @@map("visitas")
}

model Mensaje {
  id        String   @id @default(cuid())
  propId    String
  deId      String
  paraId    String
  texto     String
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  propiedad Propiedad @relation(fields: [propId], references: [id], onDelete: Cascade)
  de        Usuario   @relation("MensajesDe", fields: [deId], references: [id])
  para      Usuario   @relation("MensajesPara", fields: [paraId], references: [id])

  @@map("mensajes")
}

model Lead {
  id          String   @id @default(cuid())
  nombre      String
  email       String
  propId      String
  presupuesto String?
  estado      String   @default("new") // new | contactado | interesado | visita_agendada | lost
  score       Int      @default(50)
  fuente      String   @default("Portal")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propiedad Propiedad @relation(fields: [propId], references: [id], onDelete: Cascade)
  owner     Usuario   @relation("OwnerLeads", fields: [ownerId], references: [id])

  @@map("leads")
}

model Pago {
  id          String   @id @default(cuid())
  inquilinoId String
  propId      String
  ownerId     String
  monto       Int
  fecha       String
  estado      String   @default("pendiente") // pendiente | pagado | vencido
  metodo      String?
  wompiRef    String?
  createdAt   DateTime @default(now())

  inquilino Propiedad @relation(fields: [propId], references: [id], onDelete: Cascade)
  inq       Usuario   @relation("InquilinoPagos", fields: [inquilinoId], references: [id])
  owner     Usuario   @relation("OwnerPagos", fields: [ownerId], references: [id])

  @@map("pagos")
}

model Favorito {
  id     String @id @default(cuid())
  userId String
  propId String

  usuario   Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  propiedad Propiedad @relation(fields: [propId], references: [id], onDelete: Cascade)

  @@unique([userId, propId])
  @@map("favoritos")
}

model Suscripcion {
  id        String    @id @default(cuid())
  userId    String    @unique
  planId    String    @default("free")
  estado    String    @default("activo") // activo | cancelado | vencido
  vence     DateTime?
  wompiRef  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("suscripciones")
}
